{
  "name": "agent-skills-portal-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build -w @kurotch-homelab/agent-skills-cli && npm run build -w @kurotch-homelab/agent-skills-portal && node scripts/licenses.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "smoke": "node scripts/smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/semver": "^7.7.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "vite": "^7.1.0"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "semver": "^7.7.0",
    "tar": "^7.5.0",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "license": "MIT"
}
